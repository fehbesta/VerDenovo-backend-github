# Copie para .env somente para execução local. No Render, configure estas
# variáveis em Dashboard > serviço > Environment. Nunca preencha com segredos
# e envie este arquivo ao GitHub.
DB_URL=jdbc:sqlserver://SEU_HOST:1433;databaseName=SEU_BANCO;encrypt=true;trustServerCertificate=true
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=DEFINA_LOCALMENTE
JWT_SECRET=GERE_UM_SEGREDO_FORTE
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=DEFINA_LOCALMENTE
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=DEFINA_LOCALMENTE
# Opcional, para links de recuperação de senha:
FRONTEND_URL=http://localhost:5173
